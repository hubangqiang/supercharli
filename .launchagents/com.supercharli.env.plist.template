<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
  <dict>
    <key>Label</key>
    <string>com.supercharli.env</string>

    <key>ProgramArguments</key>
    <array>
      <string>/bin/zsh</string>
      <string>-lc</string>
      <string>__ROOT_DIR__/scripts/env/apply-launchctl-env.sh __ENV_FILE__</string>
    </array>

    <key>RunAtLoad</key>
    <true/>
  </dict>
</plist>
